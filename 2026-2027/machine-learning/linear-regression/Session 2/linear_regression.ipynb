    "import torch"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "ea5b000f",
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_linear_regression(X, y):\n",
    "    intercept = torch.ones((X.shape[0], 1))\n",
    "    X = torch.cat([intercept, X], dim = 1)\n",
    "    B = torch.inverse(X.T@X)@X.T@y\n",
    "    return X, B"
   ]
  },
